# ==============================================================================
# SNOWMOON — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development.
# NEVER commit `.env` or any file containing real API keys or private keys.
# All private keys and API credentials MUST remain strictly server-side.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SNOWMOON SERVER & DASHBOARD PORTS
# ------------------------------------------------------------------------------
# HTTP bind address for the SnowMoon Go daemon (serves REST API + embedded/static UI)
SNOWMOON_PORT=8090
SNOWMOON_HOST=127.0.0.1

# Optional persistent state file for local sandbox/simulated ledger state
SNOWMOON_STATE_FILE=.snowmoon/state.json

# ------------------------------------------------------------------------------
# 2. NEAR NETWORK & RPC CONFIGURATION
# ------------------------------------------------------------------------------
# Network selector:
#   - sandbox : Local NEAR Sandbox / deterministic contract engine (no external RPC/funds needed)
#   - testnet : NEAR Testnet (requires Testnet accounts & keys)
#   - mainnet : NEAR Mainnet (DISABLED in MVP unless explicitly unlocked by owner)
SNOWMOON_NETWORK=sandbox

# Execution mode for contract calls:
#   - sandbox : Local deterministic contract state machine mirroring snapfall-core & snapfall-audit
#   - rpc     : Live JSON-RPC calls against SNOWMOON_NEAR_RPC_URL
SNOWMOON_CHAIN_MODE=sandbox

# Active NEAR JSON-RPC endpoint (defaults to local sandbox when SNOWMOON_NETWORK=sandbox)
SNOWMOON_NEAR_RPC_URL=http://127.0.0.1:3030

# Reference NEAR RPC endpoints (do not confuse Testnet and Mainnet):
NEAR_SANDBOX_RPC_URL=http://127.0.0.1:3030
NEAR_TESTNET_RPC_URL=https://rpc.testnet.near.org
NEAR_MAINNET_RPC_URL=https://rpc.mainnet.near.org

# ------------------------------------------------------------------------------
# 3. SNOWMOON CONTRACT ACCOUNT IDS
# ------------------------------------------------------------------------------
# Core contract (JobVault + FloatPool + StorageCredits)
SNOWMOON_CORE_CONTRACT_ID=snowmoon-core.test.near

# AuditAnchor contract (Cross-contract delivery verification & immutable anchor)
SNOWMOON_AUDIT_CONTRACT_ID=snowmoon-audit.test.near

# NEP-141 USDC token contract (6 decimals: 1 USDC = 1,000,000 atomic units)
# Testnet example: usdc.fakes.testnet
# Mainnet Circle native USDC: 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
SNOWMOON_USDC_CONTRACT_ID=usdc.test.near

# Default demo participant accounts (used in sandbox mode or when wallet is in demo mode)
SNOWMOON_ADMIN_ACCOUNT_ID=admin.snowmoon.test.near
SNOWMOON_CUSTOMER_ACCOUNT_ID=customer.snowmoon.test.near
SNOWMOON_OPERATOR_ACCOUNT_ID=operator.snowmoon.test.near
SNOWMOON_LP_ACCOUNT_ID=lp.snowmoon.test.near

# ------------------------------------------------------------------------------
# 4. SERVER-SIDE SIGNER CREDENTIALS (NEVER EXPOSED TO FRONTEND)
# ------------------------------------------------------------------------------
# Leave blank in local sandbox mode. Only set in `.env` when SNOWMOON_CHAIN_MODE=rpc.
SNOWMOON_OPERATOR_PRIVATE_KEY=
SNOWMOON_ADMIN_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 5. AI WORKER EXECUTION ADAPTER (NEAR AI CLOUD / DETERMINISTIC MOCK)
# ------------------------------------------------------------------------------
# Adapter mode:
#   - auto    : Uses NEAR AI Cloud if NEAR_AI_API_KEY is set; otherwise uses clearly labelled mock AI worker
#   - near_ai : Requires NEAR_AI_API_KEY; fails if missing
#   - mock    : Always uses the deterministic local task-executing mock AI adapter
SNOWMOON_AI_MODE=auto

# NEAR AI Cloud (OpenAI-compatible inference endpoint)
NEAR_AI_BASE_URL=https://api.near.ai/v1
NEAR_AI_MODEL=fireworks::accounts/fireworks/models/llama-v3p3-70b-instruct
NEAR_AI_API_KEY=

# ------------------------------------------------------------------------------
# 6. OUTLAYER SPENDING POLICY & APPROVAL ADAPTER
# ------------------------------------------------------------------------------
# Adapter mode:
#   - auto     : Uses live OutLayer API if OUTLAYER_API_KEY is set; otherwise uses local OutLayer policy engine
#   - outlayer : Requires OUTLAYER_API_KEY; fails if missing
#   - mock     : Always uses the local deterministic OutLayer policy & approval engine
SNOWMOON_WALLET_MODE=auto

# OutLayer API configuration (server-side only)
OUTLAYER_BASE_URL=https://api.outlayer.ai/v1
OUTLAYER_API_KEY=
OUTLAYER_WEBHOOK_SECRET=

# Autonomous micro-spend threshold in atomic USDC (default: 100000 = $0.10 USDC).
# Expenses <= threshold within job max_operating_budget are auto-approved with receipt hash;
# expenses > threshold are escalated to the human Operator Approval Queue.
SNOWMOON_AUTO_APPROVE_LIMIT_USDC=100000

